{
  "entities": {
    "UserProfile": {
      "title": "UserProfile",
      "description": "User profile information and measurements",
      "type": "object",
      "properties": {
        "uid": { "type": "string" },
        "name": { "type": "string" },
        "email": { "type": "string" },
        "age": { "type": "number" },
        "height": { "type": "number" },
        "weight": { "type": "number" },
        "gender": { "type": "string", "enum": ["male", "female", "unisex"] },
        "avatar": { "type": "string" },
        "favoriteEra": { "type": "string" },
        "purpose": { "type": "string" },
        "isOnboarded": { "type": "boolean" },
        "updatedAt": { "type": "string" }
      },
      "required": ["uid", "name"]
    },
    "SavedLookbook": {
      "title": "SavedLookbook",
      "description": "Saved Vietnamese heritage fashion outfit lookbook",
      "type": "object",
      "properties": {
        "id": { "type": "string" },
        "userId": { "type": "string" },
        "title": { "type": "string" },
        "createdAt": { "type": "string" },
        "compositeImage": { "type": "string" },
        "costumeName": { "type": "string" },
        "costumeEra": { "type": "string" },
        "modernGarmentName": { "type": "string" },
        "occasion": { "type": "string" },
        "harmonyScore": { "type": "number" }
      },
      "required": ["id", "userId", "title"]
    }
  },
  "firestore": {
    "/users/{userId}": {
      "schema": "UserProfile",
      "description": "User personal profile details"
    },
    "/users/{userId}/lookbooks/{lookbookId}": {
      "schema": "SavedLookbook",
      "description": "User saved lookbook outfits"
    }
  }
}
